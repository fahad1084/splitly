# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is git-ignored. It is bundled into the app as an asset, so put ONLY
# public client values here — never the service_role key or any secret.
#
# Find both values in Supabase Dashboard → Project Settings → API.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
